NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this publicly / never prefix with NEXT_PUBLIC_

# Paystack — get these from Settings > API Keys & Webhooks
